[Unit]
Description=Kiosk session: chromium on display :0
After=network.target

[Service]
User=parcelpaler
Group=parcelpaler
Environment=DISPLAY=:0
ExecStart=/usr/bin/xinit /home/parcelpaler/.xinitrc -- :0 vt1 -nolisten tcp
Restart=always
RestartSec=5
StandardOutput=syslog
StandardError=syslog

[Install]
WantedBy=multi-user.target


